# LLM provider: xai | openai | groq | mock
LLM_PROVIDER=groq

# Grok (xAI) API Key — used for LLM chat (not embeddings)
XAI_API_KEY=

# Groq API Key + model (OpenAI-compatible endpoint)
# Note: llama3-8b-8192 was decommissioned; use llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE=https://api.groq.com/openai/v1
# Embedding model (local, free — runs via sentence-transformers)
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking defaults
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Sliding window defaults
SLIDING_WINDOW_SIZE=512
SLIDING_WINDOW_STEP=256

# Semantic chunking breakpoint type: percentile | standard_deviation | interquartile
SEMANTIC_BREAKPOINT_TYPE=percentile

# Output directories
EMBEDDINGS_OUTPUT_DIR=./output/embeddings
